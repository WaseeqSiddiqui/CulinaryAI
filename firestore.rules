rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function householdMember(householdId) {
      return signedIn() && request.auth.uid in
        get(/databases/$(database)/documents/households/$(householdId)).data.member_ids;
    }

    function householdAdmin(householdId) {
      let household = get(/databases/$(database)/documents/households/$(householdId)).data;
      return signedIn()
        && request.auth.uid in household.member_ids
        && (household.owner_id == request.auth.uid
          || household.member_roles[request.auth.uid] == 'admin');
    }

    match /users/{userId} {
      allow read, create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && (
        request.auth.uid == userId
        || (resource.data.household_id != null
          && householdAdmin(resource.data.household_id))
      );
    }

    match /households/{householdId} {
      allow create: if signedIn()
        && request.resource.data.owner_id == request.auth.uid
        && request.auth.uid in request.resource.data.member_ids
        && request.resource.data.member_roles[request.auth.uid] == 'owner';
      allow read: if householdMember(householdId);
      allow update: if signedIn() && request.resource.data.owner_id == resource.data.owner_id
        && request.resource.data.member_roles[resource.data.owner_id] == 'owner'
        && (
          householdAdmin(householdId)
          || (
            !(request.auth.uid in resource.data.member_ids)
            && request.auth.uid in request.resource.data.member_ids
            && request.resource.data.member_ids.size() == resource.data.member_ids.size() + 1
            && request.resource.data.member_roles[request.auth.uid] == 'member'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['member_ids', 'member_roles', 'updated_at'])
            && exists(/databases/$(database)/documents/household_invites/$(resource.data.invite_code))
            && get(/databases/$(database)/documents/household_invites/$(resource.data.invite_code)).data.household_id == householdId
            && get(/databases/$(database)/documents/household_invites/$(resource.data.invite_code)).data.expires_at > request.time
          )
        );
      allow delete: if signedIn() && resource.data.owner_id == request.auth.uid;

      match /pantry/{itemId} {
        allow read, write: if householdMember(householdId);
      }

      match /ledger/{eventId} {
        allow read, create: if householdMember(householdId);
        allow update, delete: if false;
      }

      match /orders/{orderId} {
        allow read: if householdMember(householdId);
        allow create, update: if householdMember(householdId)
          && request.resource.data.id == orderId
          && request.resource.data.householdId == householdId
          && request.resource.data.items is list
          && request.resource.data.items.size() > 0;
        allow delete: if false;
      }
    }

    match /household_invites/{inviteCode} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && (request.resource.data.owner_id == request.auth.uid
          || householdAdmin(request.resource.data.household_id))
        && request.resource.data.expires_at > request.time;
      allow update, delete: if signedIn()
        && householdAdmin(resource.data.household_id);
    }
  }
}
