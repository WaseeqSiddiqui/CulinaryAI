    "order_reference": "[data-testid=\"order-number\"], [data-testid=\"order-code\"]",
    "checkout_address": "[data-testid=\"delivery-address\"], [data-testid=\"location-search-button\"]",
    "checkout_total": "[data-testid=\"cartlib-total-price\"]",
    "empty_cart_labels": "your cart is empty,your basket is empty",
    "captcha": "#px-captcha, .px-captcha-container, iframe[title=\"reCAPTCHA\"]",
    "otp_prompt": "input[autocomplete=\"one-time-code\"]",
    "mobile_redirect_modal": "[data-testid=\"mweb-redirection-modal\"]",
    "address_prompt": "[data-testid=\"no-address-modal\"]"
