    "product_increment_button": "[data-testid=\"quantity-modifier-view-inc-button\"]",
    "product_quantity": "[data-testid=\"quantity-modifier-view-quantity\"]",
    "cart_container": "[data-testid=\"cart-summary-view\"]",
    "cart_open_button": "[data-testid=\"modal-cart-button\"]",
    "cart_line": "[data-testid^=\"cart-cart-row-\"]",
    "cart_line_name": ".product-name",
    "cart_line_quantity": "[data-testid$=\"-quantity\"]",
    "cart_line_price": "section.price[data-testid$=\"-price\"]",
