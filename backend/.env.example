# Groq is the default provider for all generative text and image features.
# Create a server-side key at https://console.groq.com/keys
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Monthly Free/Plus quotas require trusted Firebase server credentials.
USAGE_LIMITS_ENABLED=true
FIREBASE_PROJECT_ID=culinaryai-518b3
# Enable only after Play Console product/API access and license testing are ready.
GOOGLE_PLAY_BILLING_ENABLED=false
# On Render, add a Firebase service-account JSON as a secret file and set:
# GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/firebase-service-account.json
# Alternatively set FIREBASE_SERVICE_ACCOUNT_JSON as a server-only secret.

# Optional manual rollback. There is no automatic fallback to Gemini.
# AI_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.8-flash

# Backend Configuration
PORT=8000
HOST=0.0.0.0

# Server-side Spoonacular key selects the production recipe provider.
# SPOONACULAR_API_KEY=
# Legacy TheMealDB source when Spoonacular is not configured.
MEALDB_API_KEY=1

# Server only. Used to find matching Foodpanda restaurant menu pages.
TAVILY_API_KEY=your_tavily_api_key_here
